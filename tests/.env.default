# AWS connection
AWS_PROFILE=versity
AWS_ENDPOINT_URL=https://127.0.0.1:7070
SECRETS_FILE=./tests/.secrets

# versitygw process
VERSITY_EXE=./versitygw
RUN_VERSITYGW=true
#PORT=7070
#PORT_TWO=7071
CERT=$PWD/cert.pem
KEY=$PWD/versitygw.pem

# backend storage
BACKEND=posix
LOCAL_FOLDER=/tmp/gw
VERSIONING_DIR=/tmp/versioning

# bucket lifecycle
BUCKET_ONE_NAME=versity-gwtest-bucket-one
BUCKET_TWO_NAME=versity-gwtest-bucket-two
RECREATE_BUCKETS=true
#DELETE_BUCKETS_AFTER_TEST=true

# clients
S3CMD_CONFIG=./tests/s3cfg.local.default
MC_ALIAS=versity

# IAM and users
IAM_TYPE=folder
USERS_FOLDER=$PWD/iam
#USERS_BUCKET=
USERNAME_ONE=ABCDEFG
PASSWORD_ONE=HIJKLMN
USERNAME_TWO=HIJKLMN
PASSWORD_TWO=OPQRSTU
#AUTOGENERATE_USERS=true
#USER_AUTOGENERATION_PREFIX=
#CREATE_STATIC_USERS_IF_NONEXISTENT=false
#SKIP_USERS_TESTS=false

# direct mode
DIRECT=false
#DIRECT_DISPLAY_NAME=
#DIRECT_AWS_USER_ID=
#DIRECT_S3_ROOT_ACCOUNT_NAME=
#DIRECT_POST_COMMAND_DELAY=0
#DIRECT_CLOUDFRONT_TAG=

# logs and coverage
LOG_LEVEL=2
GOCOVERDIR=$PWD/cover
#TEST_LOG_FILE=test.log
#VERSITY_LOG_FILE=versity.log
COMMAND_LOG=command.log
TIME_LOG=time.log
#COVERAGE_LOG=
#MAX_OPENSSL_COMMAND_LOG_BYTES=

# test files and generated tools
TEST_FILE_FOLDER=$PWD/versity-gwtest-files
REMOVE_TEST_FILE_FOLDER=true
#PYTHON_ENV_FOLDER=
#TEMPLATE_MATRIX_FILE=
#GO_COMMAND_GENERATOR_EXECUTABLE=

# test behavior
#SKIP_ACL_TESTING=false
#MAX_FILE_DOWNLOAD_CHUNK_SIZE=
#SKIP_POLICY=false
#SKIP_BUCKET_OWNERSHIP_CONTROLS=false
#BYPASS_ENV_FILE=false
#QUICK_COMPARE_SIZE=

# website
#WEBSITE=
#WEBSITE_ENDPOINT=
